  "type": "module",
  "scripts": {
    "dev": "bun run --filter @aphrody/shenron-site dev",
    "start": "bun run --filter @aphrody/shenron-site start",
    "typecheck": "bun scripts/testing/workspace-gates.ts typecheck",
    "typecheck:scripts": "tsc --noEmit -p scripts",
    "check:native": "bun scripts/testing/native-quality.ts check",
    "lint:native": "bun scripts/testing/native-quality.ts lint",
    "format:native:check": "bun scripts/testing/native-quality.ts fmt",
    "test": "bun scripts/testing/workspace-gates.ts test",
    "lint": "oxlint -c .oxlintrc.json apps packages scripts",
    "format:check": "oxfmt --check apps packages scripts",
    "build": "bun scripts/build/server.ts && bun scripts/build/bot.ts",
    "build:server": "bun scripts/build/server.ts",
    "build:bot": "bun scripts/build/bot.ts",
    "check:rust": "bun scripts/build/rust/cargo.ts ck",
    "clippy:rust": "bun scripts/build/rust/cargo.ts lint",
    "test:rust": "bun scripts/build/rust/test.ts",
    "fmt:rust": "cargo fmt --all --check",
    "deny:rust": "cargo deny check",
    "test:live": "bun run --filter @aphrody/shenron-pipeline rag:test",
    "audit:assets": "bun scripts/audit/assets-dedup.ts",
    "test:scripts": "bun test --path-ignore-patterns='**/*.live.test.ts' ./scripts",
    "test:live:ai": "cd apps/site && SHENRON_LIVE=1 bun test --isolate tests/ai-layer-gemini.live.test.ts",
    "test:integration": "bun scripts/testing/integration/run.ts",
    "dev:remote": "bun scripts/dev/remote-dev.ts up",
    "remote:build": "bun scripts/ops/remote-build.ts build",
    "remote:release": "bun scripts/ops/remote-build.ts release",
    "remote:doctor": "bun scripts/ops/remote-build.ts doctor",
    "dev:env": "bun scripts/dev/env-pull.ts",
    "gates:remote": "bun scripts/dev/remote-dev.ts gates",
    "ship": "bun scripts/ops/ship.ts"
  },
  "devDependencies": {
    "@aphrody/agent-browser": "catalog:",
