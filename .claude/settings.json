{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "nextjs": {
      "source": {
        "source": "github",
        "repo": "vercel/next.js"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill"
    ],
    "defaultMode": "bypassPermissions"
  }
}
