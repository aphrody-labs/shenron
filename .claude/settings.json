{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "nextjs": {
      "source": {
        "source": "github",
        "repo": "vercel/next.js"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/dev/cloud-setup.sh\" --background",
            "timeout": 20,
            "statusMessage": "Cloud toolchain"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/dev/cloud-ssh.sh\"",
            "timeout": 20,
            "statusMessage": "SSH production"
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/dev/session-start.ts\"",
            "timeout": 20,
            "statusMessage": "Reprise du travail"
          }
        ]
      }
    ]
  }
}
