      ],
      "input": "超サイヤ人ブルーと超サイヤ人ゴッド超サイヤ人と超サイヤ人",
      "masked": "Zeta001とZeta001とZeta002",
      "tokens": [
        ["Zeta001", "Super Saiyan Blue"],
        ["Zeta002", "Super Saiyan"]
      ],
      "overflow": 0,
      "translation": "Zeta001, Zeta001 et Zeta002",
      "restored": "Super Saiyan Blue, Super Saiyan Blue et Super Saiyan",
      "unresolved": [],
      "missing": []
    },
    {
      "name": "Latin spellings match on Latin word edges only",
      "entries": [{ "sources": ["OG"], "target": "Organisme" }],
      "input": "OG と LOGO と OG72",
      "masked": "Zeta001 と LOGO と OG72",
      "tokens": [["Zeta001", "Organisme"]],
      "overflow": 0
    },
    {
      "name": "offsets are code points (astral signs before a term)",
      "entries": [{ "sources": ["孫悟空"], "target": "Son Goku" }],
      "input": "𠮷野家の孫悟空",
      "masked": "𠮷野家のZeta001",
