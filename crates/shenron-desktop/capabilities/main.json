{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The Shenron front app in the main window: bundled splash and the local loopback server (studio, Koharu and desktop commands).",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-title",
    "core:window:allow-set-progress-bar",
    "opener:default",
    "process:default"
  ]
}
