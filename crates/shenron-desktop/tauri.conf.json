{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/tauri-v3.0.0-alpha.4/crates/tauri-schema-generator/schemas/config.schema.json",
  "productName": "Shenron",
  "identifier": "com.dragonballfr.shenron",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "main",
        "shenron-admin"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "publisher": "Dragon Ball FR",
    "homepage": "https://dragonballfr.com",
    "category": "Entertainment",
    "shortDescription": "Shenron : le site Dragon Ball FR, l’éditeur de traduction manga et le studio, en local.",
    "longDescription": "Shenron réunit dans une fenêtre native le site dragonballfr.com servi en local, l’éditeur de traduction manga Koharu, le studio et la recherche RAG locale sur le corpus Dragon Ball.",
    "copyright": "© Dragon Ball FR. Dragon Ball © Bird Studio/Shueisha, Toei Animation.",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "French",
          "English"
        ],
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "fr-FR"
      }
    }
  }
}
