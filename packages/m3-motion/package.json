{
  "name": "@shenron/m3-motion",
  "version": "1.0.0",
  "description": "Material 3 animation plugin powered by Motion (formerly Framer Motion)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "motion": "^13.4.4"
  },
  "devDependencies": {
    "react-dom": "^19.3.0"
  },
  "peerDependencies": {
    "motion": ">=12.0.0",
    "react": ">=18.0.0"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "private": true,
  "shenron": {
    "runtime": {
      "*": "react"
    }
