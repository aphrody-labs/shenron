{
  "name": "@aphrody/shenron-images",
  "version": "1.4.7",
  "private": false,
  "description": "Image hashing, deduplication, variant selection and sourced illustration picking for Shenron (Bun + sharp)",
  "homepage": "https://dragonballfr.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/shenron.git",
    "directory": "packages/images"
  },
  "files": [
    "src",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./variants": {
      "types": "./src/variants.ts",
      "default": "./src/variants.ts"
    },
    "./resolve": {
      "types": "./src/resolve.ts",
      "default": "./src/resolve.ts"
    },
    "./ink-stroke": {
      "types": "./src/ink-stroke.ts",
      "default": "./src/ink-stroke.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bun check --project tsconfig.json",
    "lint": "bun lint -c ../../.oxlintrc.json src"
  },
  "dependencies": {
    "sharp": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "shenron": {
    "runtime": {
      ".": "bun",
      "./variants": "pure",
      "./resolve": "server",
      "./ink-stroke": "server"
    }
  }
}
