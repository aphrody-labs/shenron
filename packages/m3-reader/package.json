{
  "name": "@aphrody/shenron-m3-reader",
  "version": "1.0.0",
  "private": true,
  "description": "Material 3 manga and illustrated book readers for React",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./source": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./styles.css",
    "./use-focus-trap": {
      "types": "./src/use-focus-trap.ts",
      "default": "./src/use-focus-trap.ts"
    }
  },
  "dependencies": {
    "@tanstack/react-virtual": "catalog:",
    "lucide-react": "catalog:",
    "swiper": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=4.1.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "shenron": {
    "runtime": {
      "*": "react"
    }
  }
}
