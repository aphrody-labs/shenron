{
  "name": "@aphrody/shenron-engine",
  "version": "1.4.7",
  "private": false,
  "description": "Unified full-stack Shenron game engine, GPU backend, WebGPU/WASM pipeline, vector canvas, and deterministic combat core.",
  "homepage": "https://dragonballfr.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/shenron.git",
    "directory": "packages/engine"
  },
  "files": [
    "src",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./gpu": "./src/gpu.ts",
    "./game": "./src/game.ts",
    "./canvas": "./src/canvas.ts",
    "./render": "./src/render.ts",
    "./wasm": "./src/wasm.ts",
    "./unified_canvas": "./src/unified_canvas.ts",
    "./types": "./src/types.ts",
    "./toriyama3d": "./src/toriyama3d.ts",
    "./manga-scene": "./src/manga-scene.ts",
    "./glb-scene": "./src/glb-scene.ts",
    "./xv2-character": "./src/xv2-character.ts",
    "./sprite-atlas": "./src/sprite-atlas.ts",
    "./combat-atlas": "./src/combat-atlas.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "lint": "bun lint --no-n2b src test --ignore-pattern src/wasm",
    "test": "bun test",
    "typecheck": "bun check --project tsconfig.json",
    "build:wasm": "bun scripts/build-wasm.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "shenron": {
    "runtime": {
      ".": "pure",
      "./gpu": "pure",
      "./game": "pure",
      "./canvas": "pure",
      "./render": "pure",
      "./wasm": "pure",
      "./unified_canvas": "pure",
      "./types": "pure",
      "./glb-scene": "pure",
      "./xv2-character": "pure",
      "./sprite-atlas": "pure",
      "./combat-atlas": "pure"
    }
  }
}
