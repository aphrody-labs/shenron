{
  "name": "@aphrody/shenron-db",
  "version": "1.4.7",
  "private": false,
  "description": "PostgreSQL partagé Shenron : schéma Drizzle, pool postgres-js (Next) et driver Bun.SQL (scripts, API), indépendant du framework",
  "homepage": "https://dragonballfr.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/shenron.git",
    "directory": "packages/db"
  },
  "files": [
    "src",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./bot-schema": "./src/bot-schema.ts",
    "./full-schema": "./src/full-schema.ts",
    "./constants": "./src/constants.ts",
    "./config": "./src/config.ts",
    "./sql": "./src/sql.ts",
    "./postgres-js": "./src/postgres-js.ts",
    "./bun-sql": "./src/bun-sql.ts",
    "./env": "./src/env.ts",
    "./wiki-registry": "./src/wiki-registry.ts",
    "./repos/wiki": "./src/repos/wiki.ts",
    "./repos/agent-keys": "./src/repos/agent-keys.ts",
    "./repos/accounts": "./src/repos/accounts.ts",
    "./guards": "./src/guards.ts",
    "./redis": "./src/redis.ts",
    "./vfs": "./src/vfs/index.ts",
    "./dbxv2": "./src/dbxv2/index.ts",
    "./replica": "./src/replica/index.ts",
    "./conversations": "./src/conversations/index.ts",
    "./conversations/types": "./src/conversations/types.ts",
    "./conversations/redact": "./src/conversations/redact.ts",
    "./agent-homes": "./src/agent-homes/index.ts",
    "./agent-homes/types": "./src/agent-homes/types.ts",
    "./agent-homes/public-template": "./src/agent-homes/public-template.ts",
    "./vfs/build": "./src/vfs/build.ts",
    "./repos/site-theme": "./src/repos/site-theme.ts",
    "./repos/favorites": "./src/repos/favorites.ts",
    "./repos/home": "./src/repos/home.ts",
    "./repos/page-banners": "./src/repos/page-banners.ts",
    "./repos/chronology": "./src/repos/chronology.ts",
    "./repos/wiki-launch": "./src/repos/wiki-launch.ts",
    "./vfs/rag": "./src/vfs/rag.ts",
    "./vfs/schema": "./src/vfs/schema.ts",
    "./vfs/public-wiki-rag": "./src/vfs/public-wiki-rag.ts",
    "./agent-homes/dir": "./src/agent-homes/dir.ts",
    "./agent-homes/template": "./src/agent-homes/template.ts",
    "./conversations/sqlite": "./src/conversations/sqlite.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "lint": "bun lint -c ../../.oxlintrc.json",
    "test": "bun test",
    "audit:migrations": "bun scripts/migration-audit.ts --check",
    "audit:schema": "bun scripts/schema-parity.ts",
    "typecheck": "bun check --project tsconfig.json",
    "check:agent-home-template": "bun scripts/agent-home-template.ts --check"
  },
  "dependencies": {
    "@aphrody/shenron-config": "workspace:*",
    "@aphrody/sql": "catalog:",
    "@paralleldrive/cuid2": "catalog:",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "shenron": {
    "runtime": {
      ".": "server",
      "./schema": "pure",
      "./bot-schema": "pure",
      "./full-schema": "pure",
      "./constants": "pure",
      "./config": "pure",
      "./sql": "server",
      "./postgres-js": "server",
      "./bun-sql": "bun",
      "./env": "server",
      "./wiki-registry": "pure",
      "./repos/wiki": "pure",
      "./repos/agent-keys": "pure",
      "./repos/accounts": "pure",
      "./guards": "server",
      "./redis": "bun",
      "./vfs": "bun",
      "./dbxv2": "bun",
      "./replica": "bun",
      "./conversations": "bun",
      "./conversations/types": "pure",
      "./conversations/redact": "pure",
      "./agent-homes": "bun",
      "./agent-homes/types": "pure",
      "./agent-homes/public-template": "pure",
      "./vfs/build": "bun",
      "./repos/site-theme": "server",
      "./repos/favorites": "server",
      "./repos/home": "server",
      "./repos/page-banners": "server",
      "./repos/chronology": "server",
      "./repos/wiki-launch": "server",
      "./vfs/rag": "bun",
      "./vfs/schema": "bun",
      "./vfs/public-wiki-rag": "bun",
      "./agent-homes/dir": "server",
      "./agent-homes/template": "bun",
      "./conversations/sqlite": "bun"
    }
  }
}
