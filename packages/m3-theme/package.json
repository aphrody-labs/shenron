{
  "name": "@shenron/m3-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Canonical Material 3 fusion sheets: tokens.css (M3 + shadcn/ui + Tailwind v4 aliases), tailwind.css (every M3 system token as a Tailwind v4 utility) and spaceui.css (the SpaceUI themes rebuilt as M3 dynamic schemes, with SpaceUI compatibility aliases).",
  "keywords": [
    "design-tokens",
    "material-3",
    "md3",
    "shadcn",
    "spaceui",
    "tailwind"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "bun": "./src/react.tsx",
      "import": "./src/react.tsx",
      "types": "./src/react.tsx",
      "default": "./dist/react.js"
    },
    "./tauri": {
      "bun": "./src/tauri.tsx",
      "import": "./src/tauri.tsx",
      "types": "./src/tauri.tsx",
      "default": "./dist/tauri.js"
    },
    "./tokens.css": "./tokens.css",
    "./tailwind.css": "./tailwind.css",
    "./spaceui.css": "./spaceui.css"
  },
  "dependencies": {
    "@shenron/m3-tokens": "workspace:*"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.4.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "shenron": {
    "runtime": {
      "*": "react"
    }
  }
}
