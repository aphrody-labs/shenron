{
  "name": "@shenron/koharu",
  "version": "0.1.0",
  "private": true,
  "description": "Koharu manga translation engine client for Shenron: typed IPC protocol (generated from koharu-app), Tauri and native transports, settings, media and the wasm canvas.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tauri": "./src/tauri.ts",
    "./native": "./src/native.ts",
    "./settings": "./src/settings.ts",
    "./media": "./src/media.ts",
    "./canvas": "./src/canvas.ts",
    "./protocol": "./src/protocol.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint -c ../../.oxlintrc.json src --ignore-pattern src/protocol.ts --ignore-pattern src/wasm",
    "build:wasm": "RUSTFLAGS=\"--remap-path-prefix=$HOME=~\" wasm-pack build ../../crates/koharu-canvas --release --target web --out-dir ../../packages/koharu/src/wasm --out-name koharu_canvas --no-pack && bun scripts/prepare-wasm.ts",
    "protocol": "cargo run -p koharu-app --bin generate"
  },
  "dependencies": {
    "@aphrody/api": "3.0.0-alpha.2",
    "@shenron/media": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "shenron": {
    "runtime": {
      ".": "pure",
      "./tauri": "pure",
      "./native": "pure",
      "./settings": "pure",
      "./media": "pure",
      "./canvas": "pure",
      "./protocol": "pure"
    }
  }
}
