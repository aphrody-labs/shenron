{
  "name": "@shenron/koharu",
  "version": "1.4.4",
  "private": true,
  "description": "Koharu manga translation engine client for Shenron: typed IPC protocol generated from koharu-app (Tauri Specta), the koharu-sdk JSON Lines transport and the wasm canvas.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    "./native": "./src/native.ts",
    "./canvas": "./src/canvas.ts",
    "./protocol": "./src/protocol.ts"
  },
  "scripts": {
    "typecheck": "bun check --noEmit --project tsconfig.json",
    "test": "bun test",
    "lint": "oxlint -c ../../.oxlintrc.json src --ignore-pattern src/protocol.ts --ignore-pattern src/wasm",
    "build:wasm": "bun scripts/build-wasm.ts",
    "protocol": "cargo run -p koharu-app --example protocol"
  },
  "dependencies": {
    "@aphrody/api": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "shenron": {
    "runtime": {
      "./native": "bun",
      "./canvas": "react",
      "./protocol": "pure"
    }
  }
}
