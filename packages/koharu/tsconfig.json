{
  "extends": "../config/tsconfig/bun.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  "include": ["src/**/*.ts", "src/**/*.js", "test/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
