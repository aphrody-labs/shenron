import { openShenronPython } from "../../../src/runtime/python.ts";
export async function normalize(source: string) {
  await using sdk = await openShenronPython({ sourceRoots: [source] });
  return {
    pid: sdk.info().pid,
    value: await sdk.invoke("shenron.command_guard", "normalize_command", ["PyJS café🐍\u0000"]),
  };
}
