{
  "name": "@aphrody/shenron-crunchyroll",
  "version": "1.0.0",
  "private": true,
  "description": "Crunchyroll headless CLI, MCP server, and AI service provider for Shenron.",
  "license": "Apache-2.0",
  "bin": {
    "crunchyroll-cli": "./src/cli.ts",
    "crunchyroll-mcp": "./src/mcp.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./har-import": "./src/har-import.ts",
    "./html-import": "./src/html-import.ts",
    "./source-directory": "./src/source-directory.ts",
    "./import-runtime": "./src/import-runtime.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bun check --project tsconfig.json",
    "lint": "bun lint -c ../../.oxlintrc.json src",
    "cli": "bun src/cli.ts",
    "build": "bun build src/cli.ts --compile --outfile bin/crunchyroll-cli",
    "mcp": "bun src/mcp.ts"
  },
  "dependencies": {
    "@aphrody/shenron-media": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.5.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "shenron": {
    "runtime": {
      ".": "bun",
      "./types": "pure",
      "./har-import": "pure",
      "./html-import": "pure",
      "./source-directory": "bun",
      "./import-runtime": "bun"
    }
  }
}
