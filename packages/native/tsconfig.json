{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src"
  ]
}
