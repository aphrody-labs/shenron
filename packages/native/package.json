{
  "name": "@aphrody/shenron-native",
  "version": "1.4.7",
  "private": false,
  "description": "Bun FFI binding of the Shenron native library (shenron-ffi): shenron commands, RAG/persona helpers, and a worker pool for the long calls (promises, AbortSignal).",
  "homepage": "https://dragonballfr.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/shenron.git",
    "directory": "packages/native"
  },
  "files": [
    "src",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./shenron": "./src/shenron.ts",
    "./engine": "./src/engine.ts",
    "./worker": "./src/worker.ts",
    "./web/pipeline": "./src/web-pipeline.ts",
    "./re": "./src/re.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "generate:check": "bun scripts/generate.ts --check",
    "lint": "bun lint -c ../../.oxlintrc.json src test scripts",
    "test": "bun test",
    "typecheck": "bun check --project tsconfig.json"
  },
  "dependencies": {
    "@aphrody/bun": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "shenron": {
    "runtime": {
      "./shenron": "bun",
      "./engine": "bun",
      "./worker": "bun",
      "./web/pipeline": "bun",
      "./re": "bun"
    }
  }
}
