{
  "name": "@shenron/native",
  "version": "0.4.0",
  "private": true,
  "description": "Bun FFI binding of the Shenron native library (shenron-ffi): shenron commands, RAG/persona helpers, and a worker pool for the long calls (promises, AbortSignal).",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./shenron": "./src/shenron.ts",
    "./engine": "./src/engine.ts",
    "./worker": "./src/worker.ts"
  },
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "generate:check": "bun scripts/generate.ts --check",
    "lint": "oxlint -c ../../.oxlintrc.json src test scripts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "shenron": {
    "runtime": {
      "./shenron": "bun",
      "./engine": "bun",
      "./worker": "bun"
    }
  }
}
