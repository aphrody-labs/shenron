{
  "name": "@aphrody/shenron-api",
  "version": "1.4.7",
  "private": false,
  "homepage": "https://dragonballfr.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/shenron.git",
    "directory": "packages/api"
  },
  "files": [
    "src",
    "LICENSE",
    "openapi"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./contract": "./src/contract/index.ts",
    "./client": "./src/client/index.ts",
    "./http": "./src/http.ts",
    "./server": "./src/server/index.ts",
    "./next": "./src/next.ts",
    "./chat": "./src/chat/index.ts",
    "./host": "./src/host/index.ts",
    "./desktop-link": "./src/desktop-link.ts",
    "./admin-lab": "./src/admin-lab.ts",
    "./plugin": "./src/plugin/index.ts",
    "./openapi.json": "./openapi/public.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "lint": "bun lint -c ../../.oxlintrc.json",
    "test": "bun test --path-ignore-patterns='**/*.live.test.ts'",
    "openapi": "bun scripts/openapi.ts",
    "openapi:check": "bun scripts/openapi.ts --check",
    "typecheck": "bun check --project tsconfig.json"
  },
  "dependencies": {
    "@aphrody/http": "catalog:",
    "@aphrody/shenron-auth": "workspace:*",
    "@aphrody/shenron-config": "workspace:*",
    "@aphrody/shenron-db": "workspace:*",
    "@aphrody/shenron-lexicon": "workspace:*",
    "@aphrody/shenron-pipeline": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "shenron": {
    "runtime": {
      "./contract": "pure",
      "./client": "pure",
      "./http": "pure",
      "./server": "server",
      "./next": "server",
      "./chat": "bun",
      "./host": "bun",
      "./desktop-link": "server",
      "./admin-lab": "server",
      "./plugin": "server",
      "./openapi.json": "json"
    }
  }
}
