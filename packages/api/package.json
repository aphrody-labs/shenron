{
  "name": "@shenron/api",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./contract": "./src/contract/index.ts",
    "./client": "./src/client/index.ts",
    "./http": "./src/http.ts",
    "./server": "./src/server/index.ts",
    "./next": "./src/next.ts",
    "./chat": "./src/chat/index.ts",
    "./host": "./src/host/index.ts",
    "./plugin": "./src/plugin/index.ts",
    "./openapi.json": "./openapi/public.json"
  },
  "scripts": {
    "lint": "oxlint -c ../../.oxlintrc.json",
    "test": "bun test --path-ignore-patterns='**/*.live.test.ts'",
    "openapi": "bun scripts/openapi.ts",
    "openapi:check": "bun scripts/openapi.ts --check",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aphrody/http": "catalog:",
    "@shenron/auth": "workspace:*",
    "@shenron/config": "workspace:*",
    "@shenron/db": "workspace:*",
    "@shenron/lexicon": "workspace:*",
    "@shenron/pipeline": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "drizzle-orm": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "shenron": {
    "runtime": {
      "./contract": "pure",
      "./client": "pure",
      "./http": "pure",
      "./server": "server",
      "./next": "server",
      "./chat": "bun",
      "./host": "bun",
      "./plugin": "server",
      "./openapi.json": "json"
    }
  }
}
