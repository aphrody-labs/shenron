{
  "name": "@aphrody/shenron-dbxv2",
  "version": "1.4.7",
  "private": false,
  "description": "Typed DBXV2 gateway client and Bun imports for approved immutable public assets, with optional private backend adapters.",
  "homepage": "https://dragonballfr.com/games/xenoverse-2",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/shenron.git",
    "directory": "packages/dbxv2"
  },
  "files": [
    "src",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "./src/preload.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./client": "./src/client.ts",
    "./schemas": "./src/schemas.ts",
    "./texture": "./src/texture.ts",
    "./pixel-perfect": "./src/pixel-perfect.ts",
    "./errors": "./src/errors.ts",
    "./refs": "./src/refs.ts",
    "./cache": "./src/cache.ts",
    "./proxy": "./src/proxy.ts",
    "./runtime": "./src/runtime.ts",
    "./plugin": "./src/plugin.ts",
    "./preload": "./src/preload.ts",
    "./declarations": "./src/declarations.ts",
    "./guard": "./src/guard.ts",
    "./db": "./src/db.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "lint": "bun lint --no-n2b -c ../../.oxlintrc.json src test scripts",
    "test": "bun test",
    "typecheck": "bun check --project tsconfig.json",
    "types": "bun scripts/gen-types.ts"
  },
  "dependencies": {
    "@aphrody/shenron-db": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "shenron": {
    "runtime": {
      ".": "bun",
      "./env": "pure",
      "./client": "pure",
      "./schemas": "pure",
      "./texture": "pure",
      "./pixel-perfect": "pure",
      "./errors": "pure",
      "./refs": "pure",
      "./cache": "pure",
      "./proxy": "bun",
      "./runtime": "bun",
      "./plugin": "bun",
      "./preload": "bun",
      "./declarations": "bun",
      "./guard": "bun",
      "./db": "bun"
    }
  }
}
