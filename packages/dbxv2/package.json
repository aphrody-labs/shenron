{
  "name": "@aphrody/shenron-dbxv2",
  "version": "1.4.6",
  "private": true,
  "description": "Private typed access to Dragon Ball Xenoverse 2 (client of the on-demand CPK server, private database, Bun plugin). Never public, never bundled.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "./src/preload.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./client": "./src/client.ts",
    "./schemas": "./src/schemas.ts",
    "./texture": "./src/texture.ts",
    "./pixel-perfect": "./src/pixel-perfect.ts",
    "./errors": "./src/errors.ts",
    "./refs": "./src/refs.ts",
    "./cache": "./src/cache.ts",
    "./proxy": "./src/proxy.ts",
    "./runtime": "./src/runtime.ts",
    "./plugin": "./src/plugin.ts",
    "./preload": "./src/preload.ts",
    "./declarations": "./src/declarations.ts",
    "./guard": "./src/guard.ts",
    "./db": "./src/db.ts"
  },
  "scripts": {
    "lint": "bun lint --no-n2b -c ../../.oxlintrc.json src test scripts",
    "test": "bun test",
    "typecheck": "bun check --project tsconfig.json",
    "types": "bun scripts/gen-types.ts"
  },
  "dependencies": {
    "@aphrody/shenron-db": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "shenron": {
    "runtime": {
      ".": "bun",
      "./env": "pure",
      "./client": "pure",
      "./schemas": "pure",
      "./texture": "pure",
      "./pixel-perfect": "pure",
      "./errors": "pure",
      "./refs": "pure",
      "./cache": "pure",
      "./proxy": "bun",
      "./runtime": "bun",
      "./plugin": "bun",
      "./preload": "bun",
      "./declarations": "bun",
      "./guard": "bun",
      "./db": "bun"
    }
  }
}
