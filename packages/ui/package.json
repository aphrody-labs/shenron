{
  "name": "@aphrody/shenron-ui",
  "version": "1.4.7",
  "private": false,
  "description": "Shenron's single UI layer: Dragon Ball design system, site components, readers, admin primitives, the Koharu manga editor and the desktop studio.",
  "homepage": "https://dragonballfr.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/shenron.git",
    "directory": "packages/ui"
  },
  "files": [
    "src",
    "LICENSE",
    "assets"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.ts",
    "./admin": "./src/admin.ts",
    "./public": "./src/public.ts",
    "./reader": "./src/reader/index.ts",
    "./reader-styles.css": "./src/reader-styles.css",
    "./reader-dragon-ball.css": "./src/reader-dragon-ball.css",
    "./public/*": "./src/public/*.tsx",
    "./assets": "./src/assets.ts",
    "./assets/*": "./assets/*",
    "./svg": "./src/toriyama-svg/index.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./lib/page-window": "./src/lib/page-window.ts",
    "./styles.css": "./src/styles.css",
    "./site.css": "./src/site.css",
    "./toriyama.css": "./src/toriyama.css",
    "./barre-nav.css": "./src/barre-nav.css",
    "./editor.css": "./src/editor.css",
    "./editorial.css": "./src/editorial.css",
    "./tokens": "./src/tokens.ts",
    "./material-symbols": "./src/material-symbols.tsx",
    "./episode-theme-palette": "./src/episode-theme-palette.json",
    "./icones/geometries": "./src/icones/geometries.ts",
    "./icones": "./src/icones/index.tsx",
    "./toriyama": "./src/toriyama/index.ts",
    "./toriyama/*": "./src/toriyama/*.tsx",
    "./toriyama-svg": "./src/toriyama-svg/index.ts",
    "./toriyama-svg/*": "./src/toriyama-svg/*.ts",
    "./cinematic": "./src/cinematic/index.ts",
    "./cinematic/*": "./src/cinematic/*.tsx",
    "./layout/*": "./src/layout/*.tsx",
    "./navigation/*": "./src/navigation/*.tsx",
    "./admin/*": "./src/admin/*.tsx",
    "./use-focus-trap": "./src/reader/use-focus-trap.ts",
    "./koharu": "./src/koharu/index.ts",
    "./koharu/providers": "./src/koharu/providers.tsx",
    "./koharu/components/editor/useCanvas": "./src/koharu/components/editor/useCanvas.ts",
    "./koharu/components/*": "./src/koharu/components/*.tsx",
    "./koharu/lib/*": "./src/koharu/lib/*.ts",
    "./koharu/locales/*": "./src/koharu/locales/*",
    "./koharu/assets/*": "./src/koharu/assets/*",
    "./koharu.css": "./src/koharu/editor.css",
    "./studio": "./src/studio/index.ts",
    "./studio/tauri-bridge": "./src/studio/tauri-bridge.ts",
    "./studio/*": "./src/studio/*.tsx",
    "./external": "./src/external/index.ts",
    "./chat": "./src/chat/index.ts",
    "./chat/model": "./src/chat/model.ts",
    "./chat.css": "./src/chat/chat.css",
    "./dbxv2": "./src/dbxv2/index.ts",
    "./dbxv2.css": "./src/dbxv2/dbxv2.css",
    "./*": "./src/components/*.tsx",
    "./video/ShenronComposition": "./src/video/ShenronComposition.tsx"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "lint": "bun lint --no-n2b -c ../../.oxlintrc.json src",
    "test": "bun test --path-ignore-patterns='test/koharu/**' --path-ignore-patterns='test/dom/**' && bun test/koharu/run.ts && bun test --preload @aphrody/bun-test-dom ./test/dom",
    "tokens": "bun scripts/generate-tokens.ts",
    "tokens:check": "bun scripts/generate-tokens.ts --check",
    "css:equivalence": "bun scripts/check-css-equivalence.ts",
    "build:check": "bun scripts/production-check.ts",
    "portability:check": "bun scripts/check-portability.ts",
    "typecheck": "bun check --project tsconfig.json"
  },
  "dependencies": {
    "@aphrody/api": "catalog:",
    "@aphrody/m3-ai": "catalog:",
    "@aphrody/m3-primitives": "catalog:",
    "@aphrody/m3-reader": "catalog:",
    "@aphrody/m3-theme": "catalog:",
    "@aphrody/m3-tokens": "catalog:",
    "@aphrody/plugin-opener": "catalog:",
    "@aphrody/shenron-config": "workspace:*",
    "@aphrody/shenron-koharu": "workspace:*",
    "@aphrody/shenron-pipeline": "workspace:*",
    "@base-ui/react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "catalog:",
    "i18next": "catalog:",
    "i18next-browser-languagedetector": "catalog:",
    "i18next-localstorage-backend": "catalog:",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "react-colorful": "catalog:",
    "react-i18next": "catalog:",
    "react-markdown": "catalog:",
    "react-resizable-panels": "catalog:",
    "remark-gfm": "catalog:",
    "swiper": "catalog:",
    "tailwind-merge": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@aphrody/bun-test-dom": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "shenron": {
    "runtime": {
      ".": "pure",
      "./server": "react",
      "./client": "react",
      "./admin": "react",
      "./public": "react",
      "./reader": "react",
      "./reader-styles.css": "css",
      "./reader-dragon-ball.css": "css",
      "./public/*": "react",
      "./assets": "pure",
      "./assets/*": "css",
      "./svg": "pure",
      "./lib/utils": "pure",
      "./lib/page-window": "pure",
      "./styles.css": "css",
      "./site.css": "css",
      "./toriyama.css": "css",
      "./barre-nav.css": "css",
      "./editor.css": "css",
      "./editorial.css": "css",
      "./tokens": "pure",
      "./material-symbols": "react",
      "./episode-theme-palette": "json",
      "./icones/geometries": "pure",
      "./icones": "react",
      "./toriyama": "react",
      "./toriyama/*": "react",
      "./toriyama-svg": "pure",
      "./toriyama-svg/*": "pure",
      "./cinematic": "react",
      "./cinematic/*": "react",
      "./layout/*": "react",
      "./navigation/*": "react",
      "./admin/*": "react",
      "./use-focus-trap": "react",
      "./koharu": "react",
      "./koharu/providers": "react",
      "./koharu/components/editor/useCanvas": "react",
      "./koharu/components/*": "react",
      "./koharu/lib/*": "react",
      "./koharu/locales/*": "pure",
      "./koharu/assets/*": "css",
      "./koharu.css": "css",
      "./studio": "react",
      "./studio/tauri-bridge": "pure",
      "./studio/*": "react",
      "./external": "react",
      "./chat": "react",
      "./chat/model": "pure",
      "./chat.css": "css",
      "./dbxv2": "react",
      "./dbxv2.css": "css",
      "./*": "react",
      "./video/ShenronComposition": "pure"
    }
  }
}
