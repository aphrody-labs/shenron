{
  "name": "@shenron/auth",
  "version": "0.3.0",
  "private": true,
  "description": "Briques Better Auth partagées (site Next, bot Bun, API) : secret, origines, cookies, fournisseur Discord, handler Request/Response",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./origins": "./src/origins.ts",
    "./a2a": "./src/a2a.ts",
    "./crypto": "./src/crypto.ts",
    "./tokens": "./src/tokens.ts",
    "./acting-user": "./src/acting-user.ts",
    "./staff": "./src/staff.ts",
    "./ports": "./src/ports.ts",
    "./guards": "./src/guards.ts",
    "./options": "./src/options.ts",
    "./policy": "./src/policy.ts",
    "./agent-keys": "./src/agent-keys.ts",
    "./next": "./src/next.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "lint": "oxlint -c ../../.oxlintrc.json src",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shenron/config": "workspace:*"
  },
  "devDependencies": {
    "@shenron/db": "workspace:*",
    "@types/react": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "better-auth": "1.7.6",
    "next": "16.3.8",
    "react": "catalog:"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "shenron": {
    "runtime": {
      ".": "server",
      "./origins": "pure",
      "./a2a": "server",
      "./crypto": "server",
      "./tokens": "server",
      "./acting-user": "server",
      "./staff": "pure",
      "./ports": "pure",
      "./guards": "server",
      "./options": "server",
      "./policy": "pure",
      "./agent-keys": "server",
      "./next": "next",
      "./client": "react"
    }
  }
}
