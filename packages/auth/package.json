{
  "name": "@aphrody/shenron-auth",
  "version": "1.4.7",
  "private": false,
  "description": "Briques Better Auth partagées (site Next, bot Bun, API) : secret, origines, cookies, fournisseur Discord, handler Request/Response",
  "homepage": "https://dragonballfr.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/shenron.git",
    "directory": "packages/auth"
  },
  "files": [
    "src",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./origins": "./src/origins.ts",
    "./a2a": "./src/a2a.ts",
    "./crypto": "./src/crypto.ts",
    "./tokens": "./src/tokens.ts",
    "./acting-user": "./src/acting-user.ts",
    "./staff": "./src/staff.ts",
    "./ports": "./src/ports.ts",
    "./guards": "./src/guards.ts",
    "./options": "./src/options.ts",
    "./policy": "./src/policy.ts",
    "./agent-keys": "./src/agent-keys.ts",
    "./next": "./src/next.ts",
    "./client": "./src/client.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "lint": "bun lint --no-n2b -c ../../.oxlintrc.json src",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@aphrody/shenron-config": "workspace:*"
  },
  "devDependencies": {
    "@aphrody/shenron-db": "workspace:*",
    "@types/react": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "next": "catalog:",
    "react": "catalog:"
  },
  "peerDependencies": {
    "better-auth": "1.7.6",
    "next": "16.5.0-canary.5",
    "react": "catalog:"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "shenron": {
    "runtime": {
      ".": "server",
      "./origins": "pure",
      "./a2a": "server",
      "./crypto": "server",
      "./tokens": "server",
      "./acting-user": "server",
      "./staff": "pure",
      "./ports": "pure",
      "./guards": "server",
      "./options": "server",
      "./policy": "pure",
      "./agent-keys": "server",
      "./next": "next",
      "./client": "react"
    }
  }
}
