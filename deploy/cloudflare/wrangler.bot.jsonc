{
  "name": "shenron-bot",
  "main": "bot-worker.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 500
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 0.1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "routes": [{ "pattern": "bot.dragonballfr.com/*", "zone_name": "dragonballfr.com" }],
  "r2_buckets": [{ "binding": "CDN", "bucket_name": "shenron-cdn" }],
  "services": [{ "binding": "AI_SERVICE", "service": "shenron-ai" }],
  "triggers": {
    "crons": ["*/15 * * * *", "0 * * * *"]
  },
  "vars": {
    "SHENRON_PUBLIC_SITE_URL": "https://dragonballfr.com",
    "SHENRON_AI_URL": "https://ai.dragonballfr.com"
  }
}
