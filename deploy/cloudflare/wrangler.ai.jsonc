{
  "name": "shenron-ai",
  "main": "ai-worker.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "ai.dragonballfr.com/*", "zone_name": "dragonballfr.com" }],
  "limits": {
    "cpu_ms": 500,
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 0.1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
  },
  "ai": {
    "binding": "AI",
  },
  "vectorize": [
    {
      "binding": "RAG_INDEX",
      "index_name": "shenron-rag",
    },
    {
      "binding": "RAG_INDEX_M3",
      "index_name": "shenron-rag-m3",
    },
  ],
  "vars": {
    "EMBED_MODEL": "@cf/baai/bge-small-en-v1.5",
    "RAG_EMBED_MODEL": "@cf/baai/bge-m3",
    "CHAT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
  },
}
