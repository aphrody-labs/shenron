# SPDX-License-Identifier: Apache-2.0
# Alpine (musl) runtime for owner-sealed `dist/*/linux-x64-musl` artifacts.
# Build: bun scripts/build/server.ts --flavor production --target linux-x64-musl
#        bun scripts/build/bot.ts --target linux-x64-musl
#        cargo build --release --target x86_64-unknown-linux-musl -p shenron-mcp -p shenron-ffi
# Then from the repository root: docker build -f deploy/docker/Dockerfile.alpine .
FROM alpine:edge

ARG SHENRON_REVISION=unknown
LABEL org.opencontainers.image.title="Shenron (Alpine)" \
      org.opencontainers.image.description="Shenron site/server and Discord bot runtime on Alpine musl" \
      org.opencontainers.image.revision="$SHENRON_REVISION" \
      org.opencontainers.image.source="https://github.com/aphrody-labs/shenron"

ENV SHENRON_HOME=/var/lib/shenron \
    SHENRON_PROFILE=production \
    PORT=5011 \
    HOSTNAME=127.0.0.1 \
    API_PORT=5006 \
    API_HOST=127.0.0.1 \
    DATABASE_PATH=/app/data/bot.db \
    SHENRON_FFI_LIB=/usr/local/lib/libshenron_ffi.so \
    NAPI_RS_NATIVE_LIBRARY_PATH=/usr/local/bin/skia.linux-x64-musl.node \
    NEXT_TELEMETRY_DISABLED=1

RUN apk add --no-cache ca-certificates curl jq libgcc libstdc++ sqlite-libs \
 && addgroup -g 10001 shenron \
 && adduser -D -H -u 10001 -G shenron -h /var/lib/shenron -s /sbin/nologin shenron \
 && install -d -o 10001 -g 10001 /app/data /app/assets /var/lib/shenron \
 && install -d -o 10001 -g 10001 /var/lib/shenron/config /var/lib/shenron/cache /var/lib/shenron/data /var/lib/shenron/logs

COPY --chown=10001:10001 --chmod=755 dist/mcp/linux-x64-musl/shenron-mcp /usr/local/bin/shenron-mcp
COPY --chown=10001:10001 --chmod=755 dist/server/linux-x64-musl/native/libshenron_ffi.so /usr/local/lib/libshenron_ffi.so
COPY --chown=10001:10001 --chmod=644 dist/bot/linux-x64-musl/skia.linux-x64-musl.node /usr/local/bin/skia.linux-x64-musl.node
COPY --chown=10001:10001 --chmod=644 dist/bot/linux-x64-musl/pipeline.mjs /usr/local/lib/shenron/pipeline.mjs
COPY --chown=10001:10001 --chmod=644 dist/bot/linux-x64-musl/pipeline-build-receipt.json /usr/local/lib/shenron/pipeline-build-receipt.json
COPY --chown=10001:10001 --chmod=755 dist/bot/linux-x64-musl/src/db/migrations /app/src/db/migrations
COPY --chown=10001:10001 --chmod=755 dist/bot/linux-x64-musl/shenron-bot /usr/local/bin/shenron-bot
COPY --chown=10001:10001 --chmod=755 dist/server/linux-x64-musl/shenron-server /usr/local/bin/shenron-server

WORKDIR /app
USER 10001:10001
EXPOSE 5011 5006
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/shenron-server"]
CMD ["version"]
