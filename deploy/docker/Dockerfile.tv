# SPDX-License-Identifier: Apache-2.0
# tv.: the shenron-tv binary with FFmpeg and yt-dlp (checksum-verified upstream release).
# Build context: the repository root. docker build -f deploy/docker/Dockerfile.tv -t localhost/shenron-tv:<tag> .
FROM rust:1-slim-bookworm AS build
WORKDIR /src
COPY crates/shenron-tv ./
RUN cargo build --release --locked

FROM debian:bookworm-slim
ARG YTDLP_VERSION=2026.10.26
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl ffmpeg \
 && cd /tmp \
 && curl -fsSL -o yt-dlp "https://github.com/yt-dlp/yt-dlp/releases/download/${YTDLP_VERSION}/yt-dlp_linux" \
 && curl -fsSL -o SUMS "https://github.com/yt-dlp/yt-dlp/releases/download/${YTDLP_VERSION}/SHA2-256SUMS" \
 && grep " yt-dlp_linux$" SUMS | sed 's/yt-dlp_linux/yt-dlp/' | sha256sum -c - \
 && install -m0755 yt-dlp /usr/local/bin/yt-dlp \
 && rm -rf /tmp/* /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --home /var/lib/shenron-tv --create-home tv
COPY --from=build /src/target/release/shenron-tv /usr/local/bin/shenron-tv
USER 10001
ENV SHENRON_TV_DATA=/var/lib/shenron-tv SHENRON_TV_BIND=127.0.0.1:8793
EXPOSE 8793
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD ["curl", "-fsS", "http://127.0.0.1:8793/healthz"]
ENTRYPOINT ["/usr/local/bin/shenron-tv"]
