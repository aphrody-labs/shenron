# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Shenron edge (Pingora reverse proxy, TLS, cache)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/shenron/current/bin/shenron-edge --config /etc/shenron-edge/edge.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
DynamicUser=true
CacheDirectory=shenron-edge
StateDirectory=shenron-edge
ConfigurationDirectory=shenron-edge
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=2G

[Install]
WantedBy=multi-user.target
