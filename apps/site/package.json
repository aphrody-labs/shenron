{
  "name": "@aphrody/shenron-site",
  "version": "1.4.5",
  "private": true,
  "exports": {
    "./lib/wiki-slugs": "./src/lib/wiki-slugs.ts",
    "./lib/databooks-defauts": "./src/lib/databooks-defauts.ts",
    "./scripts/aphrody-corpus": "./scripts/_aphrody-corpus.ts"
  },
  "scripts": {
    "predev": "bun ../../scripts/dev/check-node-modules.ts && bun ../../packages/ui/scripts/sync-assets.ts --to public",
    "dev": "NEXT_DIST_DIR=.next-dev next-bun dev",
    "prebuild": "bun ../../scripts/dev/check-node-modules.ts && bun ../../packages/ui/scripts/sync-assets.ts --to public",
    "build": "NEXT_DIST_DIR=.next-build next-bun build",
    "start": "next-bun start",
    "lint": "bun lint -c ../../.oxlintrc.json src",
    "test": "bun test --isolate --path-ignore-patterns='**/*.live.test.ts' tests/",
    "test:dom": "bun test --isolate --preload ./tests/dom-preload.ts tests/video-player.dom.test.tsx tests/video-select.dom.test.tsx",
    "type-check:tests": "bun check -p tsconfig.tests.json",
    "wiki:repair-interviews": "bun scripts/repair-interview-databook-links.ts",
    "manga:populate": "bun scripts/populate-manga-pages.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "echo \"db:push est interdit : migrations via le runbook aphrody-infra (docs/architecture/STACK.md D5)\" >&2 && exit 1",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "typecheck": "bun check && bun check -p tsconfig.tests.json"
  },
