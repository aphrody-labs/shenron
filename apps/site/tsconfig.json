{
  "compilerOptions": {
    "target": "ESNext",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    },
    "types": ["bun"]
  },
  "include": [
    "next-env.d.ts",
    "../../packages/pipeline/src/ai/bun-yolo.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-dev/dev/types/**/*.ts",
    ".next-standalone/types/**/*.ts",
    ".next-standalone/dev/types/**/*.ts",
    ".next-qualification/types/**/*.ts",
    ".next-qualification/dev/types/**/*.ts",
    ".next-dragon-world-review/types/**/*.ts",
    ".next-dragon-world-review/dev/types/**/*.ts",
    ".next-game-world-review/types/**/*.ts",
    ".next-game-world-review/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "tests", "scripts"]
}
