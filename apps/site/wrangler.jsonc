{
  "name": "shenron-site",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "main": "vinext/server/app-router-entry",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 500,
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 0.1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
  },
  "assets": {
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "r2_buckets": [{ "binding": "CDN", "bucket_name": "shenron-cdn" }],
  "ai": {
    "binding": "AI",
  },
  "vectorize": [{ "binding": "RAG_INDEX", "index_name": "shenron-rag" }],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://dragonballfr.com",
    "NEXT_PUBLIC_CDN_URL": "https://cdn.dragonballfr.com",
    "RAG_BACKEND": "shenron",
  },
}
