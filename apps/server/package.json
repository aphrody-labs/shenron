{
  "name": "@shenron/server",
  "version": "1.1.0",
  "private": true,
  "description": "shenron-server: the Shenron front app (Next 16 standalone), the Shenron API and the local APIs in one autonomous Bun binary.",
  "license": "Apache-2.0",
  "bin": {
    "shenron-server": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "bun src/cli.ts serve",
    "test": "bun test",
    "build": "bun ../../scripts/build/server.ts",
    "lint": "oxlint -c ../../.oxlintrc.json src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shenron/api": "workspace:*",
    "@shenron/native": "workspace:*"
  },
  "devDependencies": {
    "@shenron/db": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "undici-types": "~8.9.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
