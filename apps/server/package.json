{
  "name": "@aphrody/shenron-server",
  "version": "1.4.5",
  "private": true,
  "description": "shenron-server: the Shenron front app (Next 16 standalone), the Shenron API and the local APIs in one autonomous Bun binary.",
  "license": "Apache-2.0",
  "bin": {
    "shenron-server": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "bun src/cli.ts serve",
    "start": "bun src/cli.ts serve",
    "test": "bun test",
    "build": "bun ../../scripts/build/server.ts",
    "lint": "bun lint -c ../../.oxlintrc.json src",
    "typecheck": "bun check --project tsconfig.json"
  },
  "dependencies": {
    "@aphrody/shenron-api": "workspace:*",
    "@aphrody/shenron-config": "workspace:*",
    "@aphrody/shenron-db": "workspace:*",
    "@aphrody/shenron-koharu": "workspace:*",
    "@aphrody/shenron-native": "workspace:*",
    "@aphrody/shenron-pipeline": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "undici-types": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
