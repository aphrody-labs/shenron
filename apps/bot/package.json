{
  "name": "@aphrody/shenron-bot",
  "version": "1.4.5",
  "private": true,
  "type": "module",
  "exports": {
    "./lib/rag": "./src/lib/rag.ts",
    "./data/manga-spin-offs-manifest.json": "./data/manga-spin-offs-manifest.json"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun ../../scripts/build/bot.ts",
    "compile": "bun ../../scripts/build/bot.ts",
    "lint": "bun lint -c ../../.oxlintrc.json src scripts tests drizzle.config.ts",
    "lint:fix": "bun lint -c ../../.oxlintrc.json --fix src scripts tests drizzle.config.ts",
    "test": "bun test --isolate --path-ignore-patterns='**/*.live.test.ts' tests/",
    "ids": "bun scripts/discover-ids.ts",
    "watch-logs": "bun scripts/log-watcher.ts",
    "bg:fetch": "bun scripts/fetch-backgrounds.ts --download",
    "bg:optimize": "bun scripts/optimize-backgrounds.ts",
    "bg:all": "bun scripts/fetch-backgrounds.ts --download && bun scripts/optimize-backgrounds.ts",
    "gen:entries": "bun scripts/gen-entries.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed-wiki": "bun src/db/seed-wiki.ts",
    "db:seed-triggers": "bun src/db/seed-triggers.ts",
    "db:seed-levels": "bun src/db/seed-level-rewards.ts",
    "db:seed-games": "bun src/db/seed-games.ts",
    "db:seed-xv2-portraits": "bun src/db/seed-xv2-portraits.ts",
    "db:seed-xv2-techniques": "bun src/db/seed-xv2-techniques.ts",
    "db:seed-xv2-characters": "bun src/db/seed-xv2-characters.ts",
    "db:seed-xv2-transformations": "bun src/db/seed-xv2-transformations.ts",
    "db:seed-xv2-char-techniques": "bun src/db/seed-xv2-char-techniques.ts",
    "db:seed-all": "bun src/db/seed-triggers.ts && bun src/db/seed-level-rewards.ts && bun src/db/seed-shop-banners.ts",
    "db:sync-news": "bun scripts/sync-news.ts",
    "sync:replica": "bun scripts/sync-neon-to-sqlite.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:seed-xv2-char-meta": "bun src/db/seed-xv2-char-meta.ts",
    "db:seed-xv2-all": "bun src/db/seed-xv2.ts",
    "typecheck": "bun check --project tsconfig.json && bun check --project tsconfig.scripts.json"
  },
  "dependencies": {
    "@aphrody/discord-kit": "catalog:",
    "@aphrody/messaging": "catalog:",
    "@aphrody/paths": "catalog:",
    "@aphrody/shenron-activity": "workspace:*",
    "@aphrody/shenron-api": "workspace:*",
    "@aphrody/shenron-auth": "workspace:*",
    "@aphrody/shenron-config": "workspace:*",
    "@aphrody/shenron-db": "workspace:*",
    "@aphrody/shenron-images": "workspace:*",
    "@aphrody/shenron-media": "workspace:*",
    "@aphrody/shenron-native": "workspace:*",
    "@aphrody/shenron-pipeline": "workspace:*",
    "@discordx/di": "catalog:",
    "@discordx/pagination": "catalog:",
    "@napi-rs/canvas": "catalog:",
    "@pothos/core": "catalog:",
    "better-auth": "catalog:",
    "discord.js": "catalog:",
    "discordx": "catalog:",
    "drizzle-orm": "catalog:",
    "graphql": "catalog:",
    "graphql-yoga": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "postgres": "catalog:",
    "reflect-metadata": "catalog:",
    "sharp": "catalog:",
    "sqlite-vec": "catalog:",
    "tsyringe": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aphrody/shenron-ui": "workspace:*",
    "drizzle-kit": "catalog:",
    "undici-types": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
