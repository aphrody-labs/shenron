{
  "name": "@aphrody/shenron-activity-app",
  "version": "1.4.7",
  "private": true,
  "description": "Arène Shenron: the Discord Activity server (Bun.serve, OAuth code exchange, WebSocket rooms, signed settlement) and its React client",
  "homepage": "https://dragonballfr.com",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "start": "bun src/main.ts",
    "compile": "bun scripts/compile.ts",
    "test": "bun test --path-ignore-patterns='**/*.live.test.ts' test/",
    "lint": "bun lint -c ../../.oxlintrc.json src client scripts test",
    "typecheck": "bun check --project tsconfig.json"
  },
  "dependencies": {
    "@aphrody/shenron-activity": "workspace:*",
    "@aphrody/shenron-config": "workspace:*",
    "@discord/embedded-app-sdk": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aphrody/shenron-ui": "workspace:*",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
