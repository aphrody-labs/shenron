# SPDX-License-Identifier: Apache-2.0
# Exemple d'unité systemd de l'Activité « Arène Shenron ». L'hébergement appartient à l'Infra
# d'Aphrody (aphrody-infra) : ce fichier n'est ni installé ni activé par ce dépôt.
#
# Livrable : le binaire unique de `bun run --filter @aphrody/shenron-activity-app compile --target linux-x64`
# (dist/bin/shenron-activity), ou `bun src/main.ts` avec dist/client à côté.
# Variables : docs/operations/ENV.md (« Serveur de l'Activité »), dans un fichier en 600.

[Unit]
Description=Shenron Activity server (Arène Shenron)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shenron-activity
Group=shenron-activity
EnvironmentFile=/etc/shenron/activity.env
Environment=NODE_ENV=production
Environment=SHENRON_ACTIVITY_HOST=127.0.0.1
Environment=SHENRON_ACTIVITY_PORT=5013
ExecStart=/srv/shenron-activity/shenron-activity
Restart=on-failure
RestartSec=2
# Arrêt propre : le serveur prévient les salons (`closed: shutdown`) avant de fermer.
KillSignal=SIGTERM
TimeoutStopSec=15

# Aucun accès disque en écriture : le serveur ne garde rien (les reçus en attente sont en mémoire).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryMax=512M

[Install]
WantedBy=multi-user.target
