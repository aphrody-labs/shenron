{
  "_about": "Rôles de couleur du modèle « page œuvre » de dragonballfr.com. Les valeurs sont celles de la palette DBFR existante (packages/ui/src/styles.css) ; aucun hex n'est pris aux sites officiels Super, Daima ou Bandai. Contrôle : python3 contrast.py replica/design/tokens.json",
  "color": {
    "bg": "#0a0a0a",
    "surface": "#141410",
    "border": "#2a2a26",
    "border-input": "#8a8a7e",
    "text": "#efe9d8",
    "text-muted": "#a8a393",
    "accent": "#e78220",
    "on-accent": "#0a0a0a",
    "danger": "#f10c3b",
    "success": "#2e9b41",
    "warning": "#ffd23f",
    "focus-ring": "#fefd03"
  },
  "dbfr-token": {
    "bg": "--color-dbz-bg",
    "surface": "--color-dbz-card",
    "border": "--color-dbz-border",
    "text": "--color-os",
    "accent": "--color-dbz-orange",
    "danger": "--color-dbz-red",
    "success": "--color-dbz-green",
    "warning": "--color-dbz-amber",
    "focus-ring": "--color-dbz-yellow"
  },
  "pairs": [
    ["text", "bg"],
    ["text", "surface"],
    ["text-muted", "bg"],
    ["text-muted", "surface"],
    ["on-accent", "accent"],
    ["accent", "bg"],
    ["accent", "surface"],
    ["danger", "bg"],
    ["success", "bg"],
    ["warning", "bg"],
    ["border-input", "bg", "ui"],
    ["border-input", "surface", "ui"],
    ["focus-ring", "bg", "ui"],
    ["focus-ring", "surface", "ui"]
  ],
  "font": {
    "sans": "var(--font-sans)",
    "serif": "var(--font-serif-src), Georgia, \"Times New Roman\", serif",
    "mono": "var(--font-mono-src), ui-monospace, \"SF Mono\", monospace",
    "jp": "var(--font-jp)"
  },
  "type": {
    "xs": { "size": 12, "line": 16, "weight": 500 },
    "sm": { "size": 14, "line": 20, "weight": 400 },
    "base": { "size": 16, "line": 24, "weight": 400 },
    "lg": { "size": 20, "line": 28, "weight": 600 },
    "xl": { "size": 28, "line": 34, "weight": 700 },
    "display": { "size": 40, "line": 44, "weight": 800 }
  },
  "space": [0, 4, 8, 12, 16, 24, 32, 48, 64],
  "radius": { "sm": 6, "md": 10, "lg": 16, "pill": 999 },
  "shadow": {
    "card": "0 1px 2px rgba(0,0,0,.4), 0 1px 3px rgba(0,0,0,.5)",
    "pop": "0 12px 32px rgba(0,0,0,.6)"
  },
  "motion": { "fast": "120ms", "base": "200ms", "ease": "cubic-bezier(.2,.8,.2,1)" },
  "layout": {
    "content-max": 1200,
    "header-height": 56,
    "breakpoints": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280 },
    "touch-target": 44
  }
}
